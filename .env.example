# Flask and administrator security
SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
SESSION_COOKIE_SECURE=false
ANPR_API_KEY=replace-with-a-device-api-key

# MySQL / XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=anpr_db

# Hardware bridge
SERIAL_PORT=COM5
BAUD_RATE=9600
ESP32_IP=192.168.1.160

# Optional security alert email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
